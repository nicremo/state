require "fileutils"
require "json"
require "tmpdir"

default_platform(:ios)

# fastlane evaluates this file with a relative path, so __dir__ is ".". That
# works until an action changes the working directory: deliver runs from the
# iOS project root, where "./metadata" no longer exists. Expanding once at load
# time, while the working directory is still this folder, keeps every asset
# path valid no matter where an action runs from. `fastlane ios paths` prints
# the resolved values.
FASTLANE_DIR = File.expand_path(__dir__)
IOS_ROOT = File.expand_path("..", FASTLANE_DIR)
PROJECT_PATH = File.join(IOS_ROOT, "State.xcodeproj")
METADATA_PATH = File.join(FASTLANE_DIR, "metadata")
SCREENSHOTS_PATH = File.join(FASTLANE_DIR, "screenshots")
AGE_RATING_PATH = File.join(FASTLANE_DIR, "age_rating.json")
PRIVACY_DETAILS_PATH = File.join(FASTLANE_DIR, "app_privacy_details.json")

BUNDLE_ID = "com.fabincrm.state"
APP_NAME = "State: Agent Context"
APP_SKU = ENV.fetch("STATE_APP_SKU", "state-agent-context-ios")
MARKETING_VERSION = "1.0.0"
METADATA_LANGUAGES = ["de-DE", "en-US"].freeze
BASE_TERRITORY = "DEU"
EDITABLE_VERSION_STATES = %w[
  PREPARE_FOR_SUBMISSION
  DEVELOPER_REJECTED
  REJECTED
  METADATA_REJECTED
  WAITING_FOR_REVIEW
].freeze

ASC_KEY_ID = ENV.fetch("ASC_KEY_ID", "ASCKEYID000")
ASC_ISSUER_ID = ENV.fetch("ASC_ISSUER_ID", "00000000-0000-0000-0000-000000000000")
ASC_KEY_PATH = File.expand_path(
  ENV.fetch("ASC_KEY_PATH", "~/.appstoreconnect/private_keys/AuthKey_ASCKEYID000.p8")
)

# The Xcode project is generated from project.yml, so no tracked file may carry
# a build number. The archive receives it as a build setting override instead.
# The UTC default stays below 2^32 so App Store Connect accepts every component.
def state_build_number
  ENV.fetch("BUILD_NUMBER", Time.now.utc.strftime("%y%m%d%H%M"))
end

# Xcode packages the IPA with /usr/bin/rsync, which is openrsync. openrsync
# starts its server process through PATH, so a Homebrew rsync 3.x that shadows
# it fails the export with "--extended-attributes: unknown option". Put Apple's
# rsync in front for the duration of the block and leave the rest of PATH alone.
def with_apple_rsync
  original_path = ENV["PATH"]
  shim = File.join(Dir.tmpdir, "state-fastlane-toolshim")
  FileUtils.mkdir_p(shim)
  FileUtils.ln_sf("/usr/bin/rsync", File.join(shim, "rsync"))
  ENV["PATH"] = "#{shim}:#{original_path}"
  yield
ensure
  ENV["PATH"] = original_path
end

# Authenticates Spaceship for the raw App Store Connect endpoints that no
# fastlane action wraps. The API key alone is enough, no Apple ID password and
# no two-factor prompt.
def connect_api!
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
    key_id: ASC_KEY_ID,
    issuer_id: ASC_ISSUER_ID,
    filepath: ASC_KEY_PATH
  )
end

def state_app!
  connect_api!
  app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
  UI.user_error!("#{BUNDLE_ID} is not in App Store Connect. Run `fastlane ios create_app` first.") if app.nil?
  app
end

# Number of screenshots that should end up in App Store Connect per locale.
def expected_screenshot_counts
  Dir.children(SCREENSHOTS_PATH).each_with_object({}) do |locale, counts|
    directory = File.join(SCREENSHOTS_PATH, locale)
    next unless File.directory?(directory)
    count = Dir.glob(File.join(directory, "*.png")).length
    counts[locale] = count if count > 0
  end
end

def delete_all_screenshots!(version)
  removed = 0
  version.get_app_store_version_localizations.each do |localization|
    localization.get_app_screenshot_sets.each do |set|
      removed += set.app_screenshots.length
      set.delete!
    end
  end
  removed
end

# deliver reliably lands more screenshots than there are files: 6 in a set of 4,
# every run, with or without its own overwrite. It appears to retry an upload
# whose first attempt actually succeeded. Names are unique per set, so drop
# everything after the first of each name.
def prune_duplicate_screenshots!(version)
  removed = 0
  version.get_app_store_version_localizations.each do |localization|
    localization.get_app_screenshot_sets.each do |set|
      seen = {}
      set.app_screenshots.each do |screenshot|
        if seen[screenshot.file_name]
          screenshot.delete!
          removed += 1
        else
          seen[screenshot.file_name] = true
        end
      end
    end
  end
  UI.message("Removed #{removed} duplicate screenshots") if removed > 0
  removed
end

# deliver's overwrite_screenshots has repeatedly left an extra copy behind, and
# a duplicated screenshot is only visible on the product page. Count what landed
# and fail loudly rather than shipping a listing nobody checked.
def verify_screenshot_counts!(version)
  expected = expected_screenshot_counts
  actual = Hash.new(0)
  version.get_app_store_version_localizations.each do |localization|
    localization.get_app_screenshot_sets.each do |set|
      actual[localization.locale] += set.app_screenshots.length
    end
  end

  mismatched = expected.reject { |locale, count| actual[locale] == count }
  if mismatched.empty?
    UI.success("Screenshots verified: #{expected.map { |l, c| "#{l} #{c}" }.join(', ')}")
    return
  end
  details = mismatched.map { |locale, count| "#{locale} has #{actual[locale]}, expected #{count}" }
  UI.user_error!("App Store Connect screenshots are wrong: #{details.join('; ')}. Run `fastlane ios reset_screenshots` and upload again.")
end

def editable_app_store_version!
  version = state_app!.get_app_store_versions(
    filter: { platform: Spaceship::ConnectAPI::Platform::IOS }
  ).find { |candidate| candidate.version_string == MARKETING_VERSION }
  UI.user_error!("No App Store version #{MARKETING_VERSION}. Run `fastlane ios ensure_version`.") if version.nil?
  version
end

# State declares no non-exempt encryption in Info.plist. These answers must say
# the same thing, otherwise App Review gets two contradictory statements. Change
# both together, never one alone.
def submission_info_defaults
  {
    add_id_info_uses_idfa: false,
    export_compliance_uses_encryption: false,
    export_compliance_encryption_updated: false,
    export_compliance_app_uses_encryption: false,
    export_compliance_is_exempt: false,
    export_compliance_contains_third_party_cryptography: false,
    export_compliance_contains_proprietary_cryptography: false,
    export_compliance_available_on_french_store: true,
    content_rights_contains_third_party_content: false,
    content_rights_has_rights: true
  }
end

# App Review needs a contact once a build is attached, and App Store Connect
# rejects an incomplete one outright. The name and address are already public in
# the repository history, the phone number is not, so it comes from the
# environment and never gets committed. Returns nil when it is missing.
def app_review_information
  phone = ENV["ASC_REVIEW_PHONE"].to_s.strip
  return nil if phone.empty?

  {
    first_name: ENV.fetch("ASC_REVIEW_FIRST_NAME", "Fabian"),
    last_name: ENV.fetch("ASC_REVIEW_LAST_NAME", "Bitzer"),
    email_address: ENV.fetch("ASC_REVIEW_EMAIL", "maintainer@example.com"),
    phone_number: phone,
    notes: File.read(File.join(METADATA_PATH, "review_information", "notes.txt")).strip
  }
end

# deliver always reads review information out of the metadata folder, and an
# incomplete contact fails the entire upload, screenshots included. Without a
# phone number, hand deliver a copy of the metadata that simply has no review
# information in it, so everything else still reaches App Store Connect.
def metadata_path_without_review_information
  staged = Dir.mktmpdir("state-metadata")
  Dir.children(METADATA_PATH).each do |entry|
    next if entry == "review_information"
    FileUtils.cp_r(File.join(METADATA_PATH, entry), staged)
  end
  staged
end

# The privacy nutrition label is not uploaded by any fastlane action. This file
# is the reviewed source of truth behind the answers entered by hand, so it must
# stay honest about what the server and the optional relay actually process.
def validate_privacy_declaration!
  path = PRIVACY_DETAILS_PATH
  declaration = JSON.parse(File.read(path))
  UI.user_error!("Empty privacy declaration: #{path}") if declaration.empty?

  declaration.each_with_index do |entry, index|
    category = entry["category"]
    UI.user_error!("Privacy entry #{index} has no category: #{path}") if category.nil? || category.empty?
    %w[data_types purposes data_protections note].each do |key|
      value = entry[key]
      UI.user_error!("Privacy entry #{index} (#{category}) has no #{key}: #{path}") if value.nil? || value.empty?
    end
  end
  UI.success("Privacy declaration validated: #{declaration.length} categories.")
end

platform :ios do
  before_all do
    sh("xcodegen generate --spec #{File.join(IOS_ROOT, 'project.yml')} --project #{IOS_ROOT}")
  end

  private_lane :connect_api_key do
    app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key_filepath: ASC_KEY_PATH,
      duration: 1_200,
      in_house: false
    )
  end

  desc "Verify the local release toolchain and run all tests"
  lane :diagnose do
    sh("ruby --version")
    sh("xcodebuild -version")
    sh("xcodegen --version")
    scan(
      project: PROJECT_PATH,
      scheme: "State",
      device: ENV.fetch("SCAN_DEVICE", "iPhone 16 Pro"),
      clean: true,
      code_coverage: true
    )
  end

  # The App Store Connect API cannot create an app record. Asked to, it answers
  # "The resource 'apps' does not allow 'CREATE'. Allowed operations are:
  # GET_COLLECTION, GET_INSTANCE, UPDATE". Only the App Store Connect web
  # session can, which is what produce drives, so this one lane needs an Apple
  # ID and a two-factor confirmation. Every other lane runs on the API key.
  desc "Create the App Store Connect application if it does not exist"
  lane :create_app do
    connect_api!
    existing = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    if existing
      UI.success("App Store Connect app already exists: #{existing.name} (id #{existing.id})")
      next
    end

    apple_id = ENV["FASTLANE_USER"]
    if apple_id.nil? || apple_id.empty?
      UI.user_error!(
        "#{BUNDLE_ID} has no App Store Connect record and the API cannot create one. " \
        "Run this from a terminal that can answer a two-factor prompt: " \
        "FASTLANE_USER=<apple-id> bundle exec fastlane ios create_app"
      )
    end

    produce(
      username: apple_id,
      app_identifier: BUNDLE_ID,
      app_name: APP_NAME,
      language: "en-US",
      sku: APP_SKU
    )
    UI.success("Created the App Store Connect record for #{BUNDLE_ID}")
  end

  desc "Verify App Store Connect access and the State app record"
  lane :asc_status do
    app = state_app!
    UI.success("App Store Connect ready: #{app.name} (#{app.bundle_id}, id #{app.id})")
  end

  desc "Print the latest TestFlight and App Store build numbers"
  lane :builds do
    api_key = connect_api_key
    testflight_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      version: nil,
      initial_build_number: 0
    )
    UI.message("Latest TestFlight build: #{testflight_build}")
    begin
      live_build = app_store_build_number(api_key: api_key, app_identifier: BUNDLE_ID, live: true)
      UI.message("Latest App Store build: #{live_build}")
    rescue StandardError => error
      UI.message("No live App Store build yet (#{error.message})")
    end

    # A build is only installable once Apple finishes processing it, and a
    # tester only ever sees it through a group, so report both. Without this,
    # "uploaded" reads as "ready to install on a phone", which it is not.
    app = state_app!
    Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 5).each do |build|
      UI.message("Build #{build.version}: #{build.processing_state}")
    end
    groups = app.get_beta_groups
    if groups.empty?
      UI.important("No TestFlight group yet, so nobody can install the build. Add internal testers in App Store Connect.")
    else
      groups.each do |group|
        UI.message("TestFlight group #{group.name} (#{group.is_internal_group ? 'internal' : 'external'})")
      end
    end
  end

  # A VALID build is still installable by nobody until a group exists and a
  # tester sits in it. Internal groups take App Store Connect users, so the
  # tester here has to already be a user on the account.
  desc "Create the internal TestFlight group and put the owner in it"
  lane :testflight_group do
    app = state_app!
    name = ENV.fetch("TESTFLIGHT_GROUP", "Internal")
    group = app.get_beta_groups.find { |candidate| candidate.name == name }
    if group.nil?
      # Not create_beta_group: it always sends publicLinkLimitEnabled, which
      # Apple rejects for an internal group (fastlane issue 29556). Post the
      # attributes an internal group actually accepts.
      Spaceship::ConnectAPI.test_flight_request_client.post("v1/betaGroups", {
        data: {
          type: "betaGroups",
          attributes: {
            name: name,
            isInternalGroup: true,
            hasAccessToAllBuilds: true
          },
          relationships: {
            app: { data: { type: "apps", id: app.id } }
          }
        }
      })
      group = app.get_beta_groups.find { |candidate| candidate.name == name }
      UI.user_error!("Created the group but could not read it back.") if group.nil?
      UI.success("Created internal TestFlight group #{name}")
    else
      UI.success("Internal TestFlight group #{name} already exists")
    end

    email = ENV.fetch("ASC_REVIEW_EMAIL", "maintainer@example.com")
    already = (group.beta_testers || []).any? { |tester| tester.email == email }
    if already
      UI.success("#{email} is already a tester in #{name}")
      next
    end

    # Not post_bulk_beta_tester_assignments: Apple removed the
    # v1/bulkBetaTesterAssignments endpoint it posts to. This sends a real
    # TestFlight invitation.
    Spaceship::ConnectAPI.post_beta_tester_assignment(
      beta_group_ids: [group.id],
      attributes: {
        email: email,
        firstName: ENV.fetch("ASC_REVIEW_FIRST_NAME", "Fabian"),
        lastName: ENV.fetch("ASC_REVIEW_LAST_NAME", "Bitzer")
      }
    )
    UI.success("Invited #{email} to #{name}")
  end

  # deliver's overwrite_screenshots left duplicates behind across repeated
  # uploads, so clear the sets outright before uploading again.
  desc "Delete every screenshot on the editable version"
  lane :reset_screenshots do
    removed = delete_all_screenshots!(editable_app_store_version!)
    UI.success("Removed #{removed} screenshots. Run `fastlane ios metadata` to upload a clean set.")
  end

  # The App Store icon and the product page both come from the build selected
  # for the version. Uploading to TestFlight does not select it.
  desc "Attach the newest processed build to the editable version"
  lane :select_build do
    app = state_app!
    version = editable_app_store_version!
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 10)
                                        .find { |candidate| candidate.processing_state == "VALID" }
    UI.user_error!("No processed build to attach. Check `fastlane ios builds`.") if build.nil?

    version.select_build(build_id: build.id)
    UI.success("Attached build #{build.version} to version #{version.version_string}")
  end

  # Reads every field back out of App Store Connect instead of trusting an
  # upload log. Two faults already slipped through a green log, so a check that
  # only reports what it expected to find is worth nothing here.
  desc "Audit what App Store Connect actually holds for this version"
  lane :audit do
    app = state_app!
    version = editable_app_store_version!
    problems = []

    UI.header("Version")
    UI.message("#{version.version_string}: #{version.app_store_state}")
    build = begin
      version.get_build
    rescue StandardError
      nil
    end
    if build
      UI.success("Build #{build.version} attached")
    else
      problems << "no build attached to the version"
    end

    UI.header("App information")
    info = app.fetch_edit_app_info
    if info.nil?
      problems << "no editable app info"
    else
      primary = info.primary_category&.id
      secondary = info.secondary_category&.id
      UI.message("Primary category: #{primary || 'MISSING'}")
      UI.message("Secondary category: #{secondary || 'none'}")
      problems << "no primary category" if primary.nil?

      info.get_app_info_localizations.each do |localization|
        missing = []
        missing << "name" if localization.name.to_s.empty?
        missing << "subtitle" if localization.subtitle.to_s.empty?
        missing << "privacy policy URL" if localization.privacy_policy_url.to_s.empty?
        if missing.empty?
          UI.success("#{localization.locale}: name, subtitle and privacy policy URL present")
        else
          problems << "#{localization.locale} app info is missing #{missing.join(', ')}"
        end
      end
    end

    UI.header("Localized version metadata and screenshots")
    shipped_before = app.get_app_store_versions(
      filter: { platform: Spaceship::ConnectAPI::Platform::IOS }
    ).any? { |candidate| candidate.app_store_state == "READY_FOR_SALE" }
    expected = expected_screenshot_counts
    seen_locales = []
    version.get_app_store_version_localizations.each do |localization|
      seen_locales << localization.locale
      missing = []
      missing << "description" if localization.description.to_s.empty?
      missing << "keywords" if localization.keywords.to_s.empty?
      missing << "support URL" if localization.support_url.to_s.empty?
      missing << "promotional text" if localization.promotional_text.to_s.empty?
      # App Store Connect has no "What's New" on a first release.
      missing << "release notes" if shipped_before && localization.whats_new.to_s.empty?
      problems << "#{localization.locale} is missing #{missing.join(', ')}" unless missing.empty?

      shots = localization.get_app_screenshot_sets.sum { |set| set.app_screenshots.length }
      want = expected[localization.locale]
      if want && shots != want
        problems << "#{localization.locale} has #{shots} screenshots, expected #{want}"
      end
      UI.message("#{localization.locale}: #{shots} screenshots, missing #{missing.empty? ? 'nothing' : missing.join(', ')}")
    end
    expected.each_key do |locale|
      problems << "#{locale} has no version localization" unless seen_locales.include?(locale)
    end

    UI.header("Pricing and availability")
    client = Spaceship::ConnectAPI.tunes_request_client
    begin
      schedule = client.get("v1/apps/#{app.id}/appPriceSchedule")
      problems << "no price schedule" if schedule.body.dig("data", "id").nil?
      UI.message("Price schedule present")
    rescue StandardError => error
      problems << "price schedule unreadable: #{error.message}"
    end
    begin
      availability = client.get("v1/apps/#{app.id}/appAvailabilityV2")
      if availability.body.dig("data", "id")
        UI.message("Availability configured, new territories: #{availability.body.dig('data', 'attributes', 'availableInNewTerritories')}")
      else
        problems << "no availability configured, the app would be sold nowhere"
      end
    rescue StandardError => error
      problems << "availability unreadable: #{error.message}"
    end

    UI.header("App Review")
    detail = begin
      version.fetch_app_store_review_detail
    rescue StandardError
      nil
    end
    if detail.nil?
      problems << "no App Review detail"
    else
      missing = []
      missing << "first name" if detail.contact_first_name.to_s.empty?
      missing << "last name" if detail.contact_last_name.to_s.empty?
      missing << "email" if detail.contact_email.to_s.empty?
      missing << "phone" if detail.contact_phone.to_s.empty?
      missing << "notes" if detail.notes.to_s.empty?
      if missing.empty?
        UI.success("Contact and notes complete")
      else
        problems << "App Review detail is missing #{missing.join(', ')}"
      end
    end

    UI.header("TestFlight")
    groups = app.get_beta_groups
    if groups.empty?
      problems << "no TestFlight group, so nobody can install a build"
    else
      groups.each do |group|
        # group.beta_testers is nil unless the relationship was included, so
        # reading it directly reports every group as empty.
        testers = client.get("v1/betaGroups/#{group.id}/betaTesters").body.fetch("data").length
        UI.message("#{group.name}: #{group.is_internal_group ? 'internal' : 'external'}, #{testers} testers")
        problems << "TestFlight group #{group.name} has no testers" if testers.zero?
      end
    end

    UI.header("Result")
    # The privacy nutrition label has no App Store Connect API at all, so no
    # audit can confirm it. Naming it here keeps it from being forgotten.
    UI.important("Not auditable: the App Privacy questionnaire has no API. Enter it by hand from app_privacy_details.json.")
    UI.important("Not auditable: export compliance is answered at submission time.")
    if problems.empty?
      UI.success("Everything this can check is in place.")
    else
      problems.each { |problem| UI.error("MISSING: #{problem}") }
      UI.user_error!("#{problems.length} problems in App Store Connect")
    end
  end

  # What App Store Connect actually holds, rather than what the last upload
  # claimed. Duplicate screenshot sets and a version with no build attached both
  # look fine in an upload log and wrong on the product page.
  desc "Report the screenshots and the build attached to the editable version"
  lane :store_assets do
    app = state_app!
    version = app.get_app_store_versions(
      filter: { platform: Spaceship::ConnectAPI::Platform::IOS }
    ).find { |candidate| candidate.version_string == MARKETING_VERSION }
    UI.user_error!("No App Store version #{MARKETING_VERSION}") if version.nil?

    build = begin
      version.get_build
    rescue StandardError
      nil
    end
    if build
      UI.success("Version #{version.version_string} has build #{build.version} attached")
    else
      UI.important("Version #{version.version_string} has no build attached, so the App Store icon stays a placeholder")
    end

    version.get_app_store_version_localizations.each do |localization|
      localization.get_app_screenshot_sets.each do |set|
        count = set.app_screenshots.length
        marker = count > 4 ? "  <-- more than four, likely duplicated" : ""
        UI.message("#{localization.locale} #{set.screenshot_display_type}: #{count}#{marker}")
      end
    end
  end

  desc "Validate the local App Store privacy declaration"
  lane :privacy do
    validate_privacy_declaration!
  end

  desc "Print the resolved release asset paths"
  lane :paths do
    UI.message("cwd:         #{Dir.pwd}")
    UI.message("FASTLANE_DIR #{FASTLANE_DIR}")
    UI.message("IOS_ROOT     #{IOS_ROOT}")
    UI.message("METADATA     #{METADATA_PATH} exists=#{Dir.exist?(METADATA_PATH)}")
    UI.message("SCREENSHOTS  #{SCREENSHOTS_PATH} exists=#{Dir.exist?(SCREENSHOTS_PATH)}")
    UI.message("AGE_RATING   #{AGE_RATING_PATH} exists=#{File.exist?(AGE_RATING_PATH)}")
    UI.message("PRIVACY      #{PRIVACY_DETAILS_PATH} exists=#{File.exist?(PRIVACY_DETAILS_PATH)}")
  end

  desc "Run unit and UI tests"
  lane :test do
    scan(
      project: PROJECT_PATH,
      scheme: "State",
      device: ENV.fetch("SCAN_DEVICE", "iPhone 16 Pro"),
      clean: true,
      code_coverage: true
    )
  end

  desc "Create a signed App Store archive"
  lane :build do
    build_number = state_build_number
    UI.message("Archiving State with CURRENT_PROJECT_VERSION=#{build_number}")
    with_apple_rsync do
      build_app(
        project: PROJECT_PATH,
        scheme: "State",
        clean: true,
        export_method: "app-store",
        output_directory: File.join(IOS_ROOT, "build"),
        output_name: "State.ipa",
        xcargs: "-allowProvisioningUpdates CURRENT_PROJECT_VERSION=#{build_number}"
      )
    end
  end

  desc "Upload an internal TestFlight build"
  lane :beta do
    build
    upload_to_testflight(
      api_key: connect_api_key,
      ipa: File.join(IOS_ROOT, "build/State.ipa"),
      distribute_external: false,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Capture deterministic German and English 6.9-inch screenshots"
  lane :screenshots do
    capture_screenshots(
      project: PROJECT_PATH,
      scheme: "State",
      output_directory: File.join(IOS_ROOT, "screenshots"),
      clean: true,
      erase_simulator: true,
      reinstall_app: true,
      override_status_bar: true
    )
    Dir.glob(File.join(IOS_ROOT, "screenshots", "{de-DE,en-US}", "iPhone 16 Pro Max-*.png")).each do |source|
      locale = File.basename(File.dirname(source))
      destination = File.join(SCREENSHOTS_PATH, locale)
      FileUtils.mkdir_p(destination)
      FileUtils.cp(source, destination)
    end
  end

  desc "Upload localized metadata, age rating and screenshots"
  lane :metadata do
    state_app!
    ensure_version
    version = editable_app_store_version!
    # Always start from an empty set. deliver's own overwrite has left extra
    # copies behind more than once, and duplicates only show on the store page.
    removed = delete_all_screenshots!(version)
    UI.message("Cleared #{removed} existing screenshots") if removed > 0
    review_contact = app_review_information
    unless review_contact
      UI.important(
        "No ASC_REVIEW_PHONE set, so the App Review contact is left untouched and this listing " \
        "cannot be submitted yet. Everything else still uploads. Rerun with " \
        "ASC_REVIEW_PHONE=\"+49...\" to complete it."
      )
    end
    deliver(
      api_key: connect_api_key,
      app_identifier: BUNDLE_ID,
      metadata_path: review_contact ? METADATA_PATH : metadata_path_without_review_information,
      screenshots_path: SCREENSHOTS_PATH,
      app_rating_config_path: AGE_RATING_PATH,
      app_review_information: review_contact,
      languages: METADATA_LANGUAGES,
      skip_binary_upload: true,
      skip_screenshots: false,
      # The lane already cleared the sets. Leaving deliver's own overwrite on
      # made it race its delete against its upload and land 10 or 11 where 8
      # were expected, every single run.
      overwrite_screenshots: false,
      run_precheck_before_submit: false,
      submit_for_review: false,
      force: true
    )
    prune_duplicate_screenshots!(editable_app_store_version!)
    verify_screenshot_counts!(editable_app_store_version!)
    validate_privacy_declaration!
  end

  desc "Submit the uploaded build for App Review"
  lane :review do
    state_app!
    validate_privacy_declaration!
    deliver(
      api_key: connect_api_key,
      app_identifier: BUNDLE_ID,
      submit_for_review: true,
      automatic_release: false,
      phased_release: false,
      force: true,
      run_precheck_before_submit: true,
      precheck_include_in_app_purchases: false,
      submission_information: submission_info_defaults
    )
  end

  desc "Build, upload, update metadata and submit"
  lane :release do
    state_app!
    validate_privacy_declaration!
    build
    upload_to_app_store(
      api_key: connect_api_key,
      app_identifier: BUNDLE_ID,
      ipa: File.join(IOS_ROOT, "build/State.ipa"),
      metadata_path: METADATA_PATH,
      screenshots_path: SCREENSHOTS_PATH,
      app_rating_config_path: AGE_RATING_PATH,
      languages: METADATA_LANGUAGES,
      submit_for_review: true,
      automatic_release: false,
      phased_release: false,
      force: true,
      submission_information: submission_info_defaults
    )
  end

  desc "Report the latest live App Store version"
  lane :live_check do
    build = app_store_build_number(
      api_key: connect_api_key,
      app_identifier: BUNDLE_ID,
      live: true
    )
    version = lane_context[SharedValues::LATEST_VERSION]
    UI.message("Live State version: #{version}, build #{build}")
  end

  # App Store Connect only offers a build to a version record whose version
  # string matches the binary. produce creates "1.0" while the binary carries
  # MARKETING_VERSION, so without this the build cannot be selected at all.
  desc "Make the editable App Store version match the binary marketing version"
  lane :ensure_version do
    app = state_app!
    versions = app.get_app_store_versions(
      filter: { platform: Spaceship::ConnectAPI::Platform::IOS }
    )
    if versions.any? { |version| version.version_string == MARKETING_VERSION }
      UI.success("App Store version #{MARKETING_VERSION} already exists.")
      next
    end

    editable = versions.find { |version| EDITABLE_VERSION_STATES.include?(version.app_store_state) }
    if editable
      UI.message("Renaming version #{editable.version_string} to #{MARKETING_VERSION}")
      editable.update(attributes: { versionString: MARKETING_VERSION })
      UI.success("App Store version is now #{MARKETING_VERSION}")
      next
    end

    Spaceship::ConnectAPI.post_app_store_version(
      app_id: app.id,
      attributes: {
        versionString: MARKETING_VERSION,
        platform: Spaceship::ConnectAPI::Platform::IOS,
        releaseType: "AFTER_APPROVAL"
      }
    )
    UI.success("Created App Store version #{MARKETING_VERSION}")
  end

  desc "Print the App Store version and review submission state"
  lane :review_status do
    app = state_app!
    versions = app.get_app_store_versions(
      filter: { platform: Spaceship::ConnectAPI::Platform::IOS }
    )
    if versions.empty?
      UI.message("No App Store version records yet.")
      next
    end
    versions.each do |version|
      UI.message("Version #{version.version_string}: #{version.app_store_state}")
    end
  end

  # Availability is separate from pricing: a free app with no territory
  # availability is sold nowhere. Nothing warns about that.
  desc "Make State available in every App Store territory"
  lane :availability do
    app = state_app!
    client = Spaceship::ConnectAPI.tunes_request_client

    begin
      existing = client.get("v1/apps/#{app.id}/appAvailabilityV2")
      if existing.body.dig("data", "id")
        UI.success("App availability is already configured.")
        next
      end
    rescue Spaceship::UnexpectedResponse => error
      raise unless error.message.include?("does not exist") ||
                   error.message.include?("NOT_FOUND") ||
                   error.message.include?("404")
    end

    territories = []
    cursor = nil
    loop do
      params = { limit: 200 }
      params[:cursor] = cursor unless cursor.nil?
      response = client.get("v1/territories", params)
      territories += response.body.fetch("data").map { |territory| territory.fetch("id") }
      cursor = response.body.dig("links", "next")&.[](/cursor=([^&]+)/, 1)
      break if cursor.nil?
    end
    UI.message("Fetched #{territories.length} territories")

    client.post("v2/appAvailabilities", {
      data: {
        type: "appAvailabilities",
        attributes: { availableInNewTerritories: true },
        relationships: {
          app: { data: { type: "apps", id: app.id } },
          territoryAvailabilities: {
            data: territories.map { |id| { type: "territoryAvailabilities", id: "${t-#{id}}" } }
          }
        }
      },
      included: territories.map do |id|
        {
          type: "territoryAvailabilities",
          id: "${t-#{id}}",
          attributes: { available: true },
          relationships: { territory: { data: { type: "territories", id: id } } }
        }
      end
    })
    UI.success("State is available in #{territories.length} territories, including new ones.")
  end

  desc "Make State a free app with Germany as the base territory"
  lane :pricing do
    app = state_app!
    client = Spaceship::ConnectAPI.tunes_request_client

    begin
      schedule = client.get("v1/apps/#{app.id}/appPriceSchedule")
      schedule_id = schedule.body.dig("data", "id")
      unless schedule_id.nil?
        # A brand new app reports a schedule id that has no schedule behind it
        # yet, so this lookup has to tolerate the resource being absent.
        begin
          manual_prices = client.get(
            "v1/appPriceSchedules/#{schedule_id}/manualPrices",
            { include: "appPricePoint,territory", limit: 200 }
          )
          free_points = manual_prices.body.fetch("included", []).each_with_object({}) do |item, result|
            next unless item.fetch("type") == "appPricePoints"
            result[item.fetch("id")] = item.dig("attributes", "customerPrice").to_f
          end
          already_free = manual_prices.body.fetch("data", []).any? do |price|
            next false unless price.dig("attributes", "endDate").nil?
            point_id = price.dig("relationships", "appPricePoint", "data", "id")
            free_points[point_id]&.zero?
          end
          if already_free
            UI.success("State is already priced as free.")
            next
          end
        rescue Spaceship::UnexpectedResponse => error
          raise unless error.message.include?("does not exist") || error.message.include?("NOT_FOUND")
        end
        UI.message("No active free price yet. Creating the price schedule.")
      end
    rescue Spaceship::UnexpectedResponse => error
      raise unless error.message.include?("does not exist") || error.message.include?("404") || error.message.include?("NOT_FOUND")
    end

    price_points = client.get(
      "v1/apps/#{app.id}/appPricePoints",
      { filter: { territory: BASE_TERRITORY }, include: "territory", limit: 200 }
    )
    free_point = price_points.body.fetch("data").find do |point|
      point.dig("attributes", "customerPrice").to_f.zero?
    end
    UI.user_error!("No free price point for #{BASE_TERRITORY}.") if free_point.nil?

    placeholder = "${free-price}"
    client.post("v1/appPriceSchedules", {
      data: {
        type: "appPriceSchedules",
        attributes: {},
        relationships: {
          app: { data: { type: "apps", id: app.id } },
          baseTerritory: { data: { type: "territories", id: BASE_TERRITORY } },
          manualPrices: { data: [{ type: "appPrices", id: placeholder }] }
        }
      },
      included: [
        {
          type: "appPrices",
          id: placeholder,
          attributes: { startDate: nil, endDate: nil },
          relationships: {
            appPricePoint: { data: { type: "appPricePoints", id: free_point.fetch("id") } }
          }
        }
      ]
    })
    UI.success("State is now a free app with #{BASE_TERRITORY} as the base territory.")
  end
end
