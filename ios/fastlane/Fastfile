require "fileutils"
require "json"
require "tmpdir"

default_platform(:ios)

# fastlane evaluates this file with a relative path, so __dir__ is ".". That
# works until an action changes the working directory: deliver runs from the
# iOS project root, where "./metadata" no longer exists. Expanding once at load
# time, while the working directory is still this folder, keeps every asset
# path valid no matter where an action runs from. `fastlane ios paths` prints
# the resolved values.
FASTLANE_DIR = File.expand_path(__dir__)
IOS_ROOT = File.expand_path("..", FASTLANE_DIR)
PROJECT_PATH = File.join(IOS_ROOT, "State.xcodeproj")
METADATA_PATH = File.join(FASTLANE_DIR, "metadata")
SCREENSHOTS_PATH = File.join(FASTLANE_DIR, "screenshots")
AGE_RATING_PATH = File.join(FASTLANE_DIR, "age_rating.json")
PRIVACY_DETAILS_PATH = File.join(FASTLANE_DIR, "app_privacy_details.json")

BUNDLE_ID = "com.fabincrm.state"
APP_NAME = "State: Agent Context"
APP_SKU = ENV.fetch("STATE_APP_SKU", "state-agent-context-ios")
MARKETING_VERSION = "1.0.0"
METADATA_LANGUAGES = ["de-DE", "en-US"].freeze
BASE_TERRITORY = "DEU"
EDITABLE_VERSION_STATES = %w[
  PREPARE_FOR_SUBMISSION
  DEVELOPER_REJECTED
  REJECTED
  METADATA_REJECTED
  WAITING_FOR_REVIEW
].freeze

ASC_KEY_ID = ENV.fetch("ASC_KEY_ID", "ASCKEYID000")
ASC_ISSUER_ID = ENV.fetch("ASC_ISSUER_ID", "00000000-0000-0000-0000-000000000000")
ASC_KEY_PATH = File.expand_path(
  ENV.fetch("ASC_KEY_PATH", "~/.appstoreconnect/private_keys/AuthKey_ASCKEYID000.p8")
)

# The Xcode project is generated from project.yml, so no tracked file may carry
# a build number. The archive receives it as a build setting override instead.
# The UTC default stays below 2^32 so App Store Connect accepts every component.
def state_build_number
  ENV.fetch("BUILD_NUMBER", Time.now.utc.strftime("%y%m%d%H%M"))
end

# Xcode packages the IPA with /usr/bin/rsync, which is openrsync. openrsync
# starts its server process through PATH, so a Homebrew rsync 3.x that shadows
# it fails the export with "--extended-attributes: unknown option". Put Apple's
# rsync in front for the duration of the block and leave the rest of PATH alone.
def with_apple_rsync
  original_path = ENV["PATH"]
  shim = File.join(Dir.tmpdir, "state-fastlane-toolshim")
  FileUtils.mkdir_p(shim)
  FileUtils.ln_sf("/usr/bin/rsync", File.join(shim, "rsync"))
  ENV["PATH"] = "#{shim}:#{original_path}"
  yield
ensure
  ENV["PATH"] = original_path
end

# Authenticates Spaceship for the raw App Store Connect endpoints that no
# fastlane action wraps. The API key alone is enough, no Apple ID password and
# no two-factor prompt.
def connect_api!
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
    key_id: ASC_KEY_ID,
    issuer_id: ASC_ISSUER_ID,
    filepath: ASC_KEY_PATH
  )
end

def state_app!
  connect_api!
  app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
  UI.user_error!("#{BUNDLE_ID} is not in App Store Connect. Run `fastlane ios create_app` first.") if app.nil?
  app
end

# State declares no non-exempt encryption in Info.plist. These answers must say
# the same thing, otherwise App Review gets two contradictory statements. Change
# both together, never one alone.
def submission_info_defaults
  {
    add_id_info_uses_idfa: false,
    export_compliance_uses_encryption: false,
    export_compliance_encryption_updated: false,
    export_compliance_app_uses_encryption: false,
    export_compliance_is_exempt: false,
    export_compliance_contains_third_party_cryptography: false,
    export_compliance_contains_proprietary_cryptography: false,
    export_compliance_available_on_french_store: true,
    content_rights_contains_third_party_content: false,
    content_rights_has_rights: true
  }
end

# App Review needs a contact once a build is attached. The name and address are
# already public in the repository history, the phone number is not, so it comes
# from the environment and never gets committed.
def app_review_information
  phone = ENV["ASC_REVIEW_PHONE"]
  if phone.nil? || phone.strip.empty?
    UI.user_error!(
      "App Review needs a contact phone number and this repository is public, so it is not stored here. " \
      "Run the lane with ASC_REVIEW_PHONE=\"+49...\" set."
    )
  end
  {
    first_name: ENV.fetch("ASC_REVIEW_FIRST_NAME", "Fabian"),
    last_name: ENV.fetch("ASC_REVIEW_LAST_NAME", "Bitzer"),
    email_address: ENV.fetch("ASC_REVIEW_EMAIL", "maintainer@example.com"),
    phone_number: phone.strip,
    notes: File.read(File.join(METADATA_PATH, "review_information", "notes.txt")).strip
  }
end

# The privacy nutrition label is not uploaded by any fastlane action. This file
# is the reviewed source of truth behind the answers entered by hand, so it must
# stay honest about what the server and the optional relay actually process.
def validate_privacy_declaration!
  path = PRIVACY_DETAILS_PATH
  declaration = JSON.parse(File.read(path))
  UI.user_error!("Empty privacy declaration: #{path}") if declaration.empty?

  declaration.each_with_index do |entry, index|
    category = entry["category"]
    UI.user_error!("Privacy entry #{index} has no category: #{path}") if category.nil? || category.empty?
    %w[data_types purposes data_protections note].each do |key|
      value = entry[key]
      UI.user_error!("Privacy entry #{index} (#{category}) has no #{key}: #{path}") if value.nil? || value.empty?
    end
  end
  UI.success("Privacy declaration validated: #{declaration.length} categories.")
end

platform :ios do
  before_all do
    sh("xcodegen generate --spec #{File.join(IOS_ROOT, 'project.yml')} --project #{IOS_ROOT}")
  end

  private_lane :connect_api_key do
    app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key_filepath: ASC_KEY_PATH,
      duration: 1_200,
      in_house: false
    )
  end

  desc "Verify the local release toolchain and run all tests"
  lane :diagnose do
    sh("ruby --version")
    sh("xcodebuild -version")
    sh("xcodegen --version")
    scan(
      project: PROJECT_PATH,
      scheme: "State",
      device: ENV.fetch("SCAN_DEVICE", "iPhone 16 Pro"),
      clean: true,
      code_coverage: true
    )
  end

  # The App Store Connect API cannot create an app record. Asked to, it answers
  # "The resource 'apps' does not allow 'CREATE'. Allowed operations are:
  # GET_COLLECTION, GET_INSTANCE, UPDATE". Only the App Store Connect web
  # session can, which is what produce drives, so this one lane needs an Apple
  # ID and a two-factor confirmation. Every other lane runs on the API key.
  desc "Create the App Store Connect application if it does not exist"
  lane :create_app do
    connect_api!
    existing = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    if existing
      UI.success("App Store Connect app already exists: #{existing.name} (id #{existing.id})")
      next
    end

    apple_id = ENV["FASTLANE_USER"]
    if apple_id.nil? || apple_id.empty?
      UI.user_error!(
        "#{BUNDLE_ID} has no App Store Connect record and the API cannot create one. " \
        "Run this from a terminal that can answer a two-factor prompt: " \
        "FASTLANE_USER=<apple-id> bundle exec fastlane ios create_app"
      )
    end

    produce(
      username: apple_id,
      app_identifier: BUNDLE_ID,
      app_name: APP_NAME,
      language: "en-US",
      sku: APP_SKU
    )
    UI.success("Created the App Store Connect record for #{BUNDLE_ID}")
  end

  desc "Verify App Store Connect access and the State app record"
  lane :asc_status do
    app = state_app!
    UI.success("App Store Connect ready: #{app.name} (#{app.bundle_id}, id #{app.id})")
  end

  desc "Print the latest TestFlight and App Store build numbers"
  lane :builds do
    api_key = connect_api_key
    testflight_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      version: nil,
      initial_build_number: 0
    )
    UI.message("Latest TestFlight build: #{testflight_build}")
    begin
      live_build = app_store_build_number(api_key: api_key, app_identifier: BUNDLE_ID, live: true)
      UI.message("Latest App Store build: #{live_build}")
    rescue StandardError => error
      UI.message("No live App Store build yet (#{error.message})")
    end
  end

  desc "Validate the local App Store privacy declaration"
  lane :privacy do
    validate_privacy_declaration!
  end

  desc "Print the resolved release asset paths"
  lane :paths do
    UI.message("cwd:         #{Dir.pwd}")
    UI.message("FASTLANE_DIR #{FASTLANE_DIR}")
    UI.message("IOS_ROOT     #{IOS_ROOT}")
    UI.message("METADATA     #{METADATA_PATH} exists=#{Dir.exist?(METADATA_PATH)}")
    UI.message("SCREENSHOTS  #{SCREENSHOTS_PATH} exists=#{Dir.exist?(SCREENSHOTS_PATH)}")
    UI.message("AGE_RATING   #{AGE_RATING_PATH} exists=#{File.exist?(AGE_RATING_PATH)}")
    UI.message("PRIVACY      #{PRIVACY_DETAILS_PATH} exists=#{File.exist?(PRIVACY_DETAILS_PATH)}")
  end

  desc "Run unit and UI tests"
  lane :test do
    scan(
      project: PROJECT_PATH,
      scheme: "State",
      device: ENV.fetch("SCAN_DEVICE", "iPhone 16 Pro"),
      clean: true,
      code_coverage: true
    )
  end

  desc "Create a signed App Store archive"
  lane :build do
    build_number = state_build_number
    UI.message("Archiving State with CURRENT_PROJECT_VERSION=#{build_number}")
    with_apple_rsync do
      build_app(
        project: PROJECT_PATH,
        scheme: "State",
        clean: true,
        export_method: "app-store",
        output_directory: File.join(IOS_ROOT, "build"),
        output_name: "State.ipa",
        xcargs: "-allowProvisioningUpdates CURRENT_PROJECT_VERSION=#{build_number}"
      )
    end
  end

  desc "Upload an internal TestFlight build"
  lane :beta do
    build
    upload_to_testflight(
      api_key: connect_api_key,
      ipa: File.join(IOS_ROOT, "build/State.ipa"),
      distribute_external: false,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Capture deterministic German and English 6.9-inch screenshots"
  lane :screenshots do
    capture_screenshots(
      project: PROJECT_PATH,
      scheme: "State",
      output_directory: File.join(IOS_ROOT, "screenshots"),
      clean: true,
      erase_simulator: true,
      reinstall_app: true,
      override_status_bar: true
    )
    Dir.glob(File.join(IOS_ROOT, "screenshots", "{de-DE,en-US}", "iPhone 16 Pro Max-*.png")).each do |source|
      locale = File.basename(File.dirname(source))
      destination = File.join(SCREENSHOTS_PATH, locale)
      FileUtils.mkdir_p(destination)
      FileUtils.cp(source, destination)
    end
  end

  desc "Upload localized metadata, age rating and screenshots"
  lane :metadata do
    state_app!
    ensure_version
    deliver(
      api_key: connect_api_key,
      app_identifier: BUNDLE_ID,
      metadata_path: METADATA_PATH,
      screenshots_path: SCREENSHOTS_PATH,
      app_rating_config_path: AGE_RATING_PATH,
      app_review_information: app_review_information,
      languages: METADATA_LANGUAGES,
      skip_binary_upload: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      submit_for_review: false,
      force: true
    )
    validate_privacy_declaration!
  end

  desc "Submit the uploaded build for App Review"
  lane :review do
    state_app!
    validate_privacy_declaration!
    deliver(
      api_key: connect_api_key,
      app_identifier: BUNDLE_ID,
      submit_for_review: true,
      automatic_release: false,
      phased_release: false,
      force: true,
      run_precheck_before_submit: true,
      precheck_include_in_app_purchases: false,
      submission_information: submission_info_defaults
    )
  end

  desc "Build, upload, update metadata and submit"
  lane :release do
    state_app!
    validate_privacy_declaration!
    build
    upload_to_app_store(
      api_key: connect_api_key,
      app_identifier: BUNDLE_ID,
      ipa: File.join(IOS_ROOT, "build/State.ipa"),
      metadata_path: METADATA_PATH,
      screenshots_path: SCREENSHOTS_PATH,
      app_rating_config_path: AGE_RATING_PATH,
      languages: METADATA_LANGUAGES,
      submit_for_review: true,
      automatic_release: false,
      phased_release: false,
      force: true,
      submission_information: submission_info_defaults
    )
  end

  desc "Report the latest live App Store version"
  lane :live_check do
    build = app_store_build_number(
      api_key: connect_api_key,
      app_identifier: BUNDLE_ID,
      live: true
    )
    version = lane_context[SharedValues::LATEST_VERSION]
    UI.message("Live State version: #{version}, build #{build}")
  end

  # App Store Connect only offers a build to a version record whose version
  # string matches the binary. produce creates "1.0" while the binary carries
  # MARKETING_VERSION, so without this the build cannot be selected at all.
  desc "Make the editable App Store version match the binary marketing version"
  lane :ensure_version do
    app = state_app!
    versions = app.get_app_store_versions(
      filter: { platform: Spaceship::ConnectAPI::Platform::IOS }
    )
    if versions.any? { |version| version.version_string == MARKETING_VERSION }
      UI.success("App Store version #{MARKETING_VERSION} already exists.")
      next
    end

    editable = versions.find { |version| EDITABLE_VERSION_STATES.include?(version.app_store_state) }
    if editable
      UI.message("Renaming version #{editable.version_string} to #{MARKETING_VERSION}")
      editable.update(attributes: { versionString: MARKETING_VERSION })
      UI.success("App Store version is now #{MARKETING_VERSION}")
      next
    end

    Spaceship::ConnectAPI.post_app_store_version(
      app_id: app.id,
      attributes: {
        versionString: MARKETING_VERSION,
        platform: Spaceship::ConnectAPI::Platform::IOS,
        releaseType: "AFTER_APPROVAL"
      }
    )
    UI.success("Created App Store version #{MARKETING_VERSION}")
  end

  desc "Print the App Store version and review submission state"
  lane :review_status do
    app = state_app!
    versions = app.get_app_store_versions(
      filter: { platform: Spaceship::ConnectAPI::Platform::IOS }
    )
    if versions.empty?
      UI.message("No App Store version records yet.")
      next
    end
    versions.each do |version|
      UI.message("Version #{version.version_string}: #{version.app_store_state}")
    end
  end

  desc "Make State a free app with Germany as the base territory"
  lane :pricing do
    app = state_app!
    client = Spaceship::ConnectAPI.tunes_request_client

    begin
      schedule = client.get("v1/apps/#{app.id}/appPriceSchedule")
      schedule_id = schedule.body.dig("data", "id")
      unless schedule_id.nil?
        # A brand new app reports a schedule id that has no schedule behind it
        # yet, so this lookup has to tolerate the resource being absent.
        begin
          manual_prices = client.get(
            "v1/appPriceSchedules/#{schedule_id}/manualPrices",
            { include: "appPricePoint,territory", limit: 200 }
          )
          free_points = manual_prices.body.fetch("included", []).each_with_object({}) do |item, result|
            next unless item.fetch("type") == "appPricePoints"
            result[item.fetch("id")] = item.dig("attributes", "customerPrice").to_f
          end
          already_free = manual_prices.body.fetch("data", []).any? do |price|
            next false unless price.dig("attributes", "endDate").nil?
            point_id = price.dig("relationships", "appPricePoint", "data", "id")
            free_points[point_id]&.zero?
          end
          if already_free
            UI.success("State is already priced as free.")
            next
          end
        rescue Spaceship::UnexpectedResponse => error
          raise unless error.message.include?("does not exist") || error.message.include?("NOT_FOUND")
        end
        UI.message("No active free price yet. Creating the price schedule.")
      end
    rescue Spaceship::UnexpectedResponse => error
      raise unless error.message.include?("does not exist") || error.message.include?("404") || error.message.include?("NOT_FOUND")
    end

    price_points = client.get(
      "v1/apps/#{app.id}/appPricePoints",
      { filter: { territory: BASE_TERRITORY }, include: "territory", limit: 200 }
    )
    free_point = price_points.body.fetch("data").find do |point|
      point.dig("attributes", "customerPrice").to_f.zero?
    end
    UI.user_error!("No free price point for #{BASE_TERRITORY}.") if free_point.nil?

    placeholder = "${free-price}"
    client.post("v1/appPriceSchedules", {
      data: {
        type: "appPriceSchedules",
        attributes: {},
        relationships: {
          app: { data: { type: "apps", id: app.id } },
          baseTerritory: { data: { type: "territories", id: BASE_TERRITORY } },
          manualPrices: { data: [{ type: "appPrices", id: placeholder }] }
        }
      },
      included: [
        {
          type: "appPrices",
          id: placeholder,
          attributes: { startDate: nil, endDate: nil },
          relationships: {
            appPricePoint: { data: { type: "appPricePoints", id: free_point.fetch("id") } }
          }
        }
      ]
    })
    UI.success("State is now a free app with #{BASE_TERRITORY} as the base territory.")
  end
end
