# App Store Connect credentials for the fastlane lanes.
#
# Copy this file to ios/fastlane/.env and fill in your own values. fastlane
# loads that file automatically and it is gitignored, so no account of yours
# ends up in this public repository.
#
# Anyone forking State needs their own Apple developer account here. None of
# these values are shared.

# App Store Connect API key. Create one under Users and Access, Integrations.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# Apple developer team. APPLE_TEAM_ID is the ten character team identifier,
# APP_STORE_CONNECT_TEAM_ID is the numeric App Store Connect team.
APPLE_TEAM_ID=
APP_STORE_CONNECT_TEAM_ID=

# Apple ID. Only create_app needs it, because the App Store Connect API cannot
# create an app record and produce has to sign in.
APPLE_ID=
FASTLANE_USER=

# App Review contact. App Store Connect rejects the metadata upload without a
# complete one once a build is attached.
ASC_REVIEW_FIRST_NAME=
ASC_REVIEW_LAST_NAME=
ASC_REVIEW_EMAIL=
ASC_REVIEW_PHONE=
