    "A Mac, a Linux box or a small VPS. One binary, no database to install.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Mac, eine Linux-Kiste oder ein kleiner VPS. Eine Binärdatei, keine Datenbank zu installieren."
          }
        }
      }
    },
    "A reminder is due.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erinnerung ist fällig."
          }
        }
      }
    },
    "A reminder survives the session it was created in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erinnerung überlebt die Sitzung, in der sie entstanden ist."
          }
        }
      }
    },
    "A reminder that cannot interrupt you is only a list entry. State schedules its alerts on this iPhone and marks them time sensitive, so they get through Focus modes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erinnerung, die dich nicht unterbrechen darf, ist nur ein Listeneintrag. State plant seine Hinweise auf diesem iPhone und markiert sie als zeitkritisch, damit sie durch Fokus-Modi kommen."
          }
        }
      }
    },
