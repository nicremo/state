    "Weekly" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wöchentlich"
          }
        }
      }
    },
    "Welcome to State" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen bei State"
          }
        }
      }
    },
    "Who changed what, when, and on whose instruction." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer was wann geändert hat und auf wessen Anweisung."
          }
        }
      }
    },
    "With a public State relay, for example on your VPS, your iPhone receives notifications outside the home network. The content stays end to end encrypted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit einem öffentlichen State-Relay, zum Beispiel auf deinem VPS, bekommt dein iPhone Mitteilungen auch außerhalb des WLANs. Die Inhalte bleiben Ende-zu-Ende verschlüsselt."
          }
        }
      }
    },
    "Write State data" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "State-Daten schreiben"
          }
        }
      }
    },
    "Yearly" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jährlich"
          }
        }
      }
    },
    "Yesterday" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestern"
          }
        }
      }
    },
    "You run the server. Your agents write reminders through it. This iPhone reads them, works offline and alerts you when something is due." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du betreibst den Server. Deine Agenten schreiben Erinnerungen hinein. Dieses iPhone liest sie, arbeitet offline und meldet sich, wenn etwas fällig ist."
          }
        }
      }
    },
    "Your State server" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein State-Server"
          }
        }
      }
    },
    "Your agents" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Agenten"
          }
        }
      }
    },
    "Your agents remember. You stay in control." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Agenten erinnern sich. Du behältst die Kontrolle."
          }
        }
      }
    },
    "Your name" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Name"
          }
        }
      }
    },
    "Your server prints the token once with state-server bootstrap-token. This device becomes the owner." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Server gibt das Token einmalig mit state-server bootstrap-token aus. Dieses Gerät wird Besitzer."
          }
        }
      }
    },
    "Your server, your data" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Server, deine Daten"
          }
        }
      }
    },
    "statectl stores the credential and prints the MCP server entry for this agent. Add it to that agent's own configuration." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "statectl speichert die Zugangsdaten und gibt den MCP-Server-Eintrag für diesen Agenten aus. Trage ihn in dessen eigene Konfiguration ein."
